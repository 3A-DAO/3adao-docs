{
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/3a-protocol", "destination": "/3a-protocol/welcome-to-3a", "permanent": true },
    { "source": "/:top(welcome-to-3a|protocol-documentation|technical-documentation|whitelisting-criteria|community-rewards|governance|communication|user-guide|brand-assets)/:rest*", "destination": "/3a-protocol/:top/:rest*", "permanent": true },
    { "source": "/:top(welcome-to-3a|protocol-documentation|technical-documentation|whitelisting-criteria|community-rewards|governance|communication|user-guide|brand-assets)", "destination": "/3a-protocol/:top", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/(.*).md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Vary", "value": "User-Agent, Accept" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
